{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx server/index.ts",
    "build": "npm run check && tsx script/build.ts && npm run build:liquidator",
    "build:liquidator": "esbuild server/liquidator.ts --bundle --platform=node --format=cjs --outfile=dist/liquidator.cjs --packages=external",
    "start": "cross-env NODE_ENV=production node dist/index.cjs",
    "start:engine": "cross-env NODE_ENV=production node dist/index.cjs",
    "start:failsafe": "node failsafe.cjs",
    "liquidate": "node dist/liquidator.cjs",
    "panic": "node -e 'require('fs').writeFileSync('.PANIC','manual cli panic')'",
    "check": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'server/**/*.ts' 'tests/**/*.ts'",
    "db:push": "drizzle-kit push",
    "test:smoke": "vitest run tests/smoke.test.ts",
    "test:integration": "vitest run server tests",
    "test:performance": "vitest run server/performance-monster.test.ts",
    "gate": "npm run check && npm run test:smoke && npm run test:integration",
    "test": "npm run gate",
    "resume": "node -e 'require(\"fs\").unlinkSync(\".HALT\"); require(\"fs\").unlinkSync(\".PANIC\");'"
  },
