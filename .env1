# =====================================================================
#  UNATTENDED MODE (no human approval for restart or fixes)
# =====================================================================
# Auto-restart on crash is handled by pm2/systemd/run.ps1. Auto-FIX is below.
# Pick your coding agent: opencode | antigravity | custom
AGENT_PROVIDER=opencode
# Pin the model the agent uses (RECOMMENDED -- don't rely on a default that can change).
# Use the EXACT slug from `opencode models`, INCLUDING the gateway prefix (vercel/ or zenmux/).
# Fixes are rare (incident-only) and capped (AUTOFIX_MAX_ATTEMPTS), so rate limits rarely bite,
# and a throttled model just leaves the system safely HALTED+FLAT -- it never risks funds.
# opencode tries AGENT_MODEL first, then AGENT_MODEL_FALLBACK (set this to a FREE coding model
# so a rate-limited primary can't block auto-recovery).
#   e.g. AGENT_MODEL=zenmux/openai/gpt-5.3-codex
#        AGENT_MODEL_FALLBACK=zenmux/moonshotai/kimi-k2.7-code-free
# Empty = opencode's own configured default. (opencode only; antigravity uses its own config.)
AGENT_MODEL=
AGENT_MODEL_FALLBACK=
# Optional: an explicit ordered model CHAIN (comma-separated) that OVERRIDES the two vars above.
# "Free" models still have rate limits AND daily quotas -- chain several so one exhausted quota
# isn't fatal. opencode tries them left to right; first one to succeed wins.
#   e.g. AGENT_MODELS=zenmux/moonshotai/kimi-k2.7-code-free,zenmux/z-ai/glm-5.2-free,vercel/openai/gpt-oss-120b
AGENT_MODELS=google/gemini-2.5-flash,openrouter/qwen/qwen3-coder:free,openrouter/qwen/qwen3-next-80b-a3b-instruct:free,openrouter/meta-llama/llama-3.3-70b-instruct:free,openrouter/cohere/north-mini-code:free
AGENT_MODEL_RETRIES=2
AGENT_RETRY_BACKOFF_MS=30000
# AUTO_FIX calls this; the adapter (agent-run.cjs) dispatches per AGENT_PROVIDER.
# Leave as-is unless you know what you're doing.
AGENT_CMD=node agent-run.cjs "{INCIDENT}" {BRANCH}
# Only used when AGENT_PROVIDER=custom -- your literal command ({INCIDENT}/{BRANCH} substituted):
AGENT_RAW_CMD=
GIT_MAIN_BRANCH=main
# Push fixes to your git remote (main) after they pass gates. Git history keeps
# every change, so any auto-fix can be rolled back with git revert.
AUTO_PUSH=true
GIT_REMOTE=origin
# A fix must clear BOTH gates before going live: tests, then a paper canary.
AUTOFIX_MAX_ATTEMPTS=3
AUTOFIX_WINDOW_MS=86400000
CANARY_MINUTES=15

# --- Money-protection circuit breaker (always on, even unattended) ---
# Engine should self-HALT + liquidate if daily realized loss exceeds this (SOL).
MAX_DAILY_LOSS_SOL=0.005
# Hard cap on consecutive auto-restarts before the watchdog liquidates + stays down.
MAX_RESTART_LOOP=8

RESET_DAILY_ON_BOOT=0

PAPER_SEED=0.05

WHALE_TRACKING=true
RELAX_GRADED_LP_VETO_LIVE=false
MAX_CONCURRENT_TRADES=1

EDGE_POCKET_ONLY=false

