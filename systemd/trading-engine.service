# /etc/systemd/system/trading-engine.service
[Unit]
Description=Solana Trading Engine
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/bot
EnvironmentFile=/opt/bot/.env
ExecStart=/usr/bin/node dist/live-runner.js
Restart=on-failure
RestartSec=5
# Stop quickly when the failsafe asks (it calls `systemctl stop trading-engine`)
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
